{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "mock-server",
    "namespace": "default",
    "labels": null
  },
  "spec": {
    "clusterIP": "10.96.163.170",
    "clusterIPs": [
      "10.96.163.170"
    ],
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "http",
        "port": 8080,
        "protocol": "TCP",
        "targetPort": 8080
      }
    ],
    "selector": {
      "app": "mock-server"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}

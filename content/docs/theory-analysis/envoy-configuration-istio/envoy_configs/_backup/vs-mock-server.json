{
  "apiVersion": "networking.istio.io/v1",
  "kind": "VirtualService",
  "metadata": {
    "name": "mock-server",
    "namespace": "default"
  },
  "spec": {
    "hosts": [
      "mock-server"
    ],
    "http": [
      {
        "retries": {
          "attempts": 2
        },
        "route": [
          {
            "destination": {
              "host": "mock-server"
            }
          }
        ]
      }
    ]
  }
}
